# Local: http://localhost:3000. Vercel: exact HTTPS preview/site origin.
NEXT_PUBLIC_SITE_URL=

# Public Supabase connection details.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
JOBS_SECRET=

# Contact verification: allow the actual local/preview hostnames in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact mail. Configure Auth SMTP separately in Supabase.
RESEND_API_KEY=
RESEND_FROM=
PRIVACY_CONTACT_EMAIL=

# One-time LOCAL bootstrap only. Remove the password after initial setup.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
